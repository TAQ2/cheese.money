# Optional: CH3 Connect source builds
# Leave these unset to disable optional CH3 Connect features in local source builds.
# Release builds inject their public values at build time. Do not add server-side
# secrets to this file.

# Get these from the Clerk Dashboard under API keys, JWT templates, and OAuth applications.
# CH3CODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CH3CODE_CLERK_JWT_TEMPLATE=ch3-relay
# CH3CODE_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in CH3CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# CH3CODE_APPLE_TEAM_ID=ABC1234567
# CH3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/ch3.provisionprofile
# CH3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Get this from your relay deployment. `infra/relay` deploys update it automatically.
# CH3CODE_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.ch3.codes; override to test against a staging deployment.
# CH3CODE_HOSTED_APP_URL=https://nightly.app.ch3.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# CH3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# CH3CODE_MOBILE_OTLP_TRACES_DATASET=ch3-mobile-traces-dev
# CH3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
